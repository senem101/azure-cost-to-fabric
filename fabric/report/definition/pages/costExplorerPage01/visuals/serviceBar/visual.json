{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "serviceBar",
  "position": {
    "x": 876,
    "y": 460,
    "z": 8000,
    "width": 384,
    "height": 240,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Service"
                    }
                  },
                  "Property": "Service"
                }
              },
              "queryRef": "Service.Service",
              "nativeQueryRef": "Service",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Cost"
                    }
                  },
                  "Property": "Effective Cost"
                }
              },
              "queryRef": "Cost.Effective Cost",
              "nativeQueryRef": "Effective Cost",
              "displayName": "Maliyet"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Cost"
                  }
                },
                "Property": "Effective Cost"
              }
            },
            "direction": "Descending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Servise göre maliyet'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
