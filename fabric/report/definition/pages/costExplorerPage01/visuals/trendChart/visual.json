{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "trendChart",
  "position": {
    "x": 300,
    "y": 185,
    "z": 6000,
    "width": 960,
    "height": 260,
    "tabOrder": 6000
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Year"
                }
              },
              "queryRef": "Date.Year",
              "nativeQueryRef": "Year",
              "displayName": "Yıl",
              "active": false
            },
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Year Month"
                }
              },
              "queryRef": "Date.Year Month",
              "nativeQueryRef": "Year Month",
              "displayName": "Ay",
              "active": true
            },
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Date"
                }
              },
              "queryRef": "Date.Date",
              "nativeQueryRef": "Date",
              "displayName": "Gün",
              "active": false
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Cost"
                    }
                  },
                  "Property": "Effective Cost"
                }
              },
              "queryRef": "Cost.Effective Cost",
              "nativeQueryRef": "Effective Cost",
              "displayName": "Maliyet"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Date"
                  }
                },
                "Property": "Year Month"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Maliyet trendi (Yıl > Ay > Gün; drill-down okları ile granülarite değiştirin)'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
