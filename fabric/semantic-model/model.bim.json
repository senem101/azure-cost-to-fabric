        "measures": [
          {
            "name": "Effective Cost",
            "expression": "SUM ( 'Cost'[effective_cost] )",
            "formatString": "#,0.00",
            "lineageTag": "723dea8d-4a8a-5cdf-a927-625ca0eaba70",
            "displayFolder": "Cost"
          },
          {
            "name": "Billed Cost",
            "expression": "SUM ( 'Cost'[billed_cost] )",
            "formatString": "#,0.00",
            "lineageTag": "8f681728-64db-555f-9b4b-db666a6ef544",
            "displayFolder": "Cost"
          },
          {
            "name": "List Cost",
            "expression": "SUM ( 'Cost'[list_cost] )",
            "formatString": "#,0.00",
            "lineageTag": "f7b3b665-d334-541f-a027-a959ac1f696e",
            "displayFolder": "Cost"
          },
          {
            "name": "Savings",
            "expression": "[List Cost] - [Effective Cost]",
            "formatString": "#,0.00",
            "lineageTag": "bc56f44d-6440-54a9-b999-1f59ef56e686",
            "displayFolder": "Savings"
          },
          {
            "name": "Savings %",
            "expression": "DIVIDE ( [Savings], [List Cost] )",
            "formatString": "0.0%",
            "lineageTag": "b65bf00b-2f37-504d-b6c2-79c754a10a80",
            "displayFolder": "Savings"
          },
          {
            "name": "Effective Cost MTD",
            "expression": "TOTALMTD ( [Effective Cost], 'Date'[Date] )",
            "formatString": "#,0.00",
            "lineageTag": "d6dcc182-5a1d-5a57-a72d-41e19663f7f7",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Effective Cost YTD",
            "expression": "TOTALYTD ( [Effective Cost], 'Date'[Date] )",
            "formatString": "#,0.00",
            "lineageTag": "be657dbb-57ad-52b8-94ca-c6b76c1365d4",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Effective Cost PM",
            "expression": "CALCULATE ( [Effective Cost], DATEADD ( 'Date'[Date], -1, MONTH ) )",
            "formatString": "#,0.00",
            "lineageTag": "4dd2bf67-f872-5126-8d59-941f69ac33b1",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "MoM Change",
            "expression": "IF ( NOT ISBLANK ( [Effective Cost PM] ), [Effective Cost] - [Effective Cost PM] )",
            "formatString": "#,0.00",
            "lineageTag": "cc1467b3-0b61-5941-8ac9-4e22185d459f",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "MoM Change %",
            "expression": "DIVIDE ( [MoM Change], [Effective Cost PM] )",
            "formatString": "+0.0%;-0.0%;0.0%",
            "lineageTag": "382c595b-7dbe-5c92-a6b4-0d243fcfdbcf",
            "displayFolder": "Time intelligence"
          },
          {
            "name": "Avg Daily Cost",
            "expression": "AVERAGEX ( VALUES ( 'Date'[Date] ), [Effective Cost] )",
            "formatString": "#,0.00",
            "lineageTag": "fbe3ffe9-5f57-5f70-bab8-7f85bf89cd24",
            "displayFolder": "Cost"
          },
          {
            "name": "Resource Count",
            "expression": "CALCULATE ( DISTINCTCOUNT ( 'Cost'[resource_key] ), 'Cost'[resource_key] <> \"unassigned\" )",
            "formatString": "#,0",
            "lineageTag": "199dbab9-1e63-56e4-9b0a-002609a20fa7",
            "displayFolder": "Cost"
          },
